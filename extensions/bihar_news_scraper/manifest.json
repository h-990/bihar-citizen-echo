{
  "manifest_version": 3,
  "name": "Bihar News & Grievance Scraper",
  "version": "1.0.0",
  "description": "High-speed news feed, RSS & web scraper for Bihar local news and public grievances.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "ws://localhost:8000/*",
    "*://*.bhaskar.com/*",
    "*://*.prabhatkhabar.com/*",
    "*://*.livehindustan.com/*",
    "*://*.jagran.com/*",
    "*://*.amarujala.com/*",
    "*://*.indiatimes.com/*",
    "*://*.bihar.gov.in/*",
    "*://news.google.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bhaskar.com/*",
        "*://*.prabhatkhabar.com/*",
        "*://*.livehindustan.com/*",
        "*://*.jagran.com/*",
        "*://*.amarujala.com/*",
        "*://*.indiatimes.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bihar News & Grievance Scraper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
